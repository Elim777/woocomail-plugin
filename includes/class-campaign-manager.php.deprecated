<?php
/**
 * Campaign Manager
 *
 * Admin UI for creating and managing post-purchase email campaigns
 * HIGH PRIORITY FEATURE - This is the core functionality of the plugin
 *
 * @package WooOneClick
 */

if (!defined('ABSPATH')) {
    exit;
}

class OneClick_Campaign_Manager {

    public function __construct() {
        add_action('init', [$this, 'register_campaign_post_type']);
        add_action('add_meta_boxes', [$this, 'add_campaign_meta_boxes']);
        add_action('save_post_oneclick_campaign', [$this, 'save_campaign_meta'], 10, 2);
        add_filter('manage_oneclick_campaign_posts_columns', [$this, 'campaign_columns']);
        add_action('manage_oneclick_campaign_posts_custom_column', [$this, 'campaign_column_content'], 10, 2);
    }

    /**
     * Register campaign custom post type
     */
    public function register_campaign_post_type() {
        register_post_type('oneclick_campaign', [
            'labels' => [
                'name' => __('Email Campaigns', 'woo-oneclick'),
                'singular_name' => __('Campaign', 'woo-oneclick'),
                'add_new' => __('Add New Campaign', 'woo-oneclick'),
                'add_new_item' => __('Add New Campaign', 'woo-oneclick'),
                'edit_item' => __('Edit Campaign', 'woo-oneclick'),
                'new_item' => __('New Campaign', 'woo-oneclick'),
                'view_item' => __('View Campaign', 'woo-oneclick'),
                'search_items' => __('Search Campaigns', 'woo-oneclick'),
                'not_found' => __('No campaigns found', 'woo-oneclick'),
                'not_found_in_trash' => __('No campaigns found in trash', 'woo-oneclick'),
            ],
            'public' => false,
            'show_ui' => true,
            'show_in_menu' => 'oneclick-settings',
            'supports' => ['title'],
            'menu_icon' => 'dashicons-email-alt',
            'capability_type' => 'post',
            'capabilities' => [
                'edit_post' => 'manage_woocommerce',
                'read_post' => 'manage_woocommerce',
                'delete_post' => 'manage_woocommerce',
                'edit_posts' => 'manage_woocommerce',
                'edit_others_posts' => 'manage_woocommerce',
                'delete_posts' => 'manage_woocommerce',
                'publish_posts' => 'manage_woocommerce',
                'read_private_posts' => 'manage_woocommerce',
            ],
        ]);
    }

    /**
     * Add meta boxes for campaign settings
     */
    public function add_campaign_meta_boxes() {
        add_meta_box(
            'oneclick_campaign_settings',
            __('Campaign Settings', 'woo-oneclick'),
            [$this, 'render_settings_meta_box'],
            'oneclick_campaign',
            'normal',
            'high'
        );

        add_meta_box(
            'oneclick_campaign_trigger',
            __('Trigger Product', 'woo-oneclick'),
            [$this, 'render_trigger_meta_box'],
            'oneclick_campaign',
            'normal',
            'high'
        );

        add_meta_box(
            'oneclick_campaign_offer',
            __('Offer Product', 'woo-oneclick'),
            [$this, 'render_offer_meta_box'],
            'oneclick_campaign',
            'normal',
            'high'
        );

        add_meta_box(
            'oneclick_campaign_email',
            __('Email Content', 'woo-oneclick'),
            [$this, 'render_email_meta_box'],
            'oneclick_campaign',
            'normal',
            'high'
        );
    }

    /**
     * Render Campaign Settings meta box
     */
    public function render_settings_meta_box($post) {
        wp_nonce_field('oneclick_campaign_meta', 'oneclick_campaign_nonce');

        $status = get_post_meta($post->ID, '_campaign_status', true) ?: 'inactive';
        $delay = get_post_meta($post->ID, '_campaign_delay', true) ?: '5';

        ?>
        <table class="form-table">
            <tr>
                <th scope="row">
                    <label for="campaign_status"><?php _e('Status', 'woo-oneclick'); ?></label>
                </th>
                <td>
                    <select id="campaign_status" name="campaign_status" style="width: 200px;">
                        <option value="inactive" <?php selected($status, 'inactive'); ?>><?php _e('Inactive', 'woo-oneclick'); ?></option>
                        <option value="active" <?php selected($status, 'active'); ?>><?php _e('Active', 'woo-oneclick'); ?></option>
                    </select>
                    <p class="description"><?php _e('Only active campaigns will send emails', 'woo-oneclick'); ?></p>
                </td>
            </tr>
            <tr>
                <th scope="row">
                    <label for="campaign_delay"><?php _e('Email Delay (minutes)', 'woo-oneclick'); ?></label>
                </th>
                <td>
                    <input type="number" id="campaign_delay" name="campaign_delay" value="<?php echo esc_attr($delay); ?>" min="1" max="10080" step="1" style="width: 100px;">
                    <p class="description"><?php _e('How many minutes after purchase to send the email (e.g., 1 = 1 minute, 60 = 1 hour, 1440 = 1 day)', 'woo-oneclick'); ?></p>
                </td>
            </tr>
        </table>
        <?php
    }

    /**
     * Render Trigger Product meta box
     */
    public function render_trigger_meta_box($post) {
        $trigger_product_id = get_post_meta($post->ID, '_trigger_product_id', true);

        ?>
        <table class="form-table">
            <tr>
                <th scope="row">
                    <label for="trigger_product_id"><?php _e('Trigger Product', 'woo-oneclick'); ?></label>
                </th>
                <td>
                    <select id="trigger_product_id" name="trigger_product_id" style="width: 100%;">
                        <option value=""><?php _e('Select a product...', 'woo-oneclick'); ?></option>
                        <?php
                        $products = wc_get_products(['limit' => -1, 'status' => 'publish']);
                        foreach ($products as $product) {
                            printf(
                                '<option value="%d" %s>%s (#%d)</option>',
                                $product->get_id(),
                                selected($trigger_product_id, $product->get_id(), false),
                                esc_html($product->get_name()),
                                $product->get_id()
                            );
                        }
                        ?>
                    </select>
                    <p class="description"><?php _e('When customer buys THIS product, the campaign will trigger', 'woo-oneclick'); ?></p>
                </td>
            </tr>
        </table>
        <?php
    }

    /**
     * Render Offer Product meta box
     */
    public function render_offer_meta_box($post) {
        $offer_product_id = get_post_meta($post->ID, '_offer_product_id', true);
        $discount = get_post_meta($post->ID, '_offer_discount', true) ?: '10';

        ?>
        <table class="form-table">
            <tr>
                <th scope="row">
                    <label for="offer_product_id"><?php _e('Offer Product', 'woo-oneclick'); ?></label>
                </th>
                <td>
                    <select id="offer_product_id" name="offer_product_id" style="width: 100%;">
                        <option value=""><?php _e('Select a product...', 'woo-oneclick'); ?></option>
                        <?php
                        $products = wc_get_products(['limit' => -1, 'status' => 'publish']);
                        foreach ($products as $product) {
                            printf(
                                '<option value="%d" %s>%s (#%d) - %s</option>',
                                $product->get_id(),
                                selected($offer_product_id, $product->get_id(), false),
                                esc_html($product->get_name()),
                                $product->get_id(),
                                wc_price($product->get_price())
                            );
                        }
                        ?>
                    </select>
                    <p class="description"><?php _e('The product that will be offered in the email', 'woo-oneclick'); ?></p>
                </td>
            </tr>
            <tr>
                <th scope="row">
                    <label for="offer_discount"><?php _e('Discount (%)', 'woo-oneclick'); ?></label>
                </th>
                <td>
                    <input type="number" id="offer_discount" name="offer_discount" value="<?php echo esc_attr($discount); ?>" min="0" max="100" step="1" style="width: 100px;">
                    <span>%</span>
                    <p class="description"><?php _e('Discount percentage for the offer product (0-100%)', 'woo-oneclick'); ?></p>
                </td>
            </tr>
        </table>
        <?php
    }

    /**
     * Render Email Content meta box
     */
    public function render_email_meta_box($post) {
        $subject = get_post_meta($post->ID, '_email_subject', true) ?: __('Special offer just for you!', 'woo-oneclick');
        $body = get_post_meta($post->ID, '_email_body', true) ?: $this->get_default_email_body();

        ?>
        <table class="form-table">
            <tr>
                <th scope="row">
                    <label for="email_subject"><?php _e('Email Subject', 'woo-oneclick'); ?></label>
                </th>
                <td>
                    <input type="text" id="email_subject" name="email_subject" value="<?php echo esc_attr($subject); ?>" style="width: 100%;">
                    <p class="description"><?php _e('The subject line of the email', 'woo-oneclick'); ?></p>
                </td>
            </tr>
            <tr>
                <th scope="row">
                    <label for="email_body"><?php _e('Email Body', 'woo-oneclick'); ?></label>
                </th>
                <td>
                    <?php
                    wp_editor($body, 'email_body', [
                        'textarea_name' => 'email_body',
                        'textarea_rows' => 15,
                        'media_buttons' => false,
                        'teeny' => false,
                        'quicktags' => true,
                    ]);
                    ?>
                    <p class="description">
                        <?php _e('Email content. You can use these placeholders:', 'woo-oneclick'); ?>
                        <br>
                        <code>{customer_name}</code> - <?php _e('Customer\'s name', 'woo-oneclick'); ?>
                        <br>
                        <code>{product_name}</code> - <?php _e('Offer product name', 'woo-oneclick'); ?>
                        <br>
                        <code>{original_price}</code> - <?php _e('Original price', 'woo-oneclick'); ?>
                        <br>
                        <code>{discounted_price}</code> - <?php _e('Price after discount', 'woo-oneclick'); ?>
                        <br>
                        <code>{discount}</code> - <?php _e('Discount percentage', 'woo-oneclick'); ?>
                        <br>
                        <code>{purchase_link}</code> - <?php _e('One-click purchase link (auto-generated)', 'woo-oneclick'); ?>
                    </p>
                </td>
            </tr>
        </table>
        <?php
    }

    /**
     * Get default email body template
     */
    private function get_default_email_body() {
        return <<<HTML
<p>Hi {customer_name},</p>

<p>Thank you for your recent purchase! We have a special offer just for you:</p>

<h3>{product_name}</h3>

<p><strong>Original Price:</strong> <del>{original_price}</del></p>
<p><strong>Your Special Price:</strong> {discounted_price} (Save {discount}%!)</p>

<p>Click below to purchase with one click:</p>

<p>{purchase_link}</p>

<p>This offer is exclusive and won't last long!</p>

<p>Best regards,<br>Your Store Team</p>
HTML;
    }

    /**
     * Save campaign meta data
     */
    public function save_campaign_meta($post_id, $post) {
        // Check nonce
        if (!isset($_POST['oneclick_campaign_nonce']) || !wp_verify_nonce($_POST['oneclick_campaign_nonce'], 'oneclick_campaign_meta')) {
            return;
        }

        // Check autosave
        if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) {
            return;
        }

        // Check permissions
        if (!current_user_can('manage_woocommerce', $post_id)) {
            return;
        }

        // Save campaign settings
        if (isset($_POST['campaign_status'])) {
            update_post_meta($post_id, '_campaign_status', sanitize_text_field($_POST['campaign_status']));
        }

        if (isset($_POST['campaign_delay'])) {
            update_post_meta($post_id, '_campaign_delay', absint($_POST['campaign_delay']));
        }

        // Save trigger product
        if (isset($_POST['trigger_product_id'])) {
            update_post_meta($post_id, '_trigger_product_id', absint($_POST['trigger_product_id']));
        }

        // Save offer product and discount
        if (isset($_POST['offer_product_id'])) {
            update_post_meta($post_id, '_offer_product_id', absint($_POST['offer_product_id']));
        }

        if (isset($_POST['offer_discount'])) {
            $discount = min(100, max(0, absint($_POST['offer_discount'])));
            update_post_meta($post_id, '_offer_discount', $discount);
        }

        // Save email content
        if (isset($_POST['email_subject'])) {
            update_post_meta($post_id, '_email_subject', sanitize_text_field($_POST['email_subject']));
        }

        if (isset($_POST['email_body'])) {
            update_post_meta($post_id, '_email_body', wp_kses_post($_POST['email_body']));
        }
    }

    /**
     * Add custom columns to campaigns list
     */
    public function campaign_columns($columns) {
        $new_columns = [];
        $new_columns['cb'] = $columns['cb'];
        $new_columns['title'] = $columns['title'];
        $new_columns['status'] = __('Status', 'woo-oneclick');
        $new_columns['trigger'] = __('Trigger Product', 'woo-oneclick');
        $new_columns['offer'] = __('Offer Product', 'woo-oneclick');
        $new_columns['discount'] = __('Discount', 'woo-oneclick');
        $new_columns['delay'] = __('Delay', 'woo-oneclick');
        $new_columns['date'] = $columns['date'];

        return $new_columns;
    }

    /**
     * Display custom column content
     */
    public function campaign_column_content($column, $post_id) {
        switch ($column) {
            case 'status':
                $status = get_post_meta($post_id, '_campaign_status', true);
                if ($status === 'active') {
                    echo '<span style="color: green;">● ' . __('Active', 'woo-oneclick') . '</span>';
                } else {
                    echo '<span style="color: gray;">○ ' . __('Inactive', 'woo-oneclick') . '</span>';
                }
                break;

            case 'trigger':
                $product_id = get_post_meta($post_id, '_trigger_product_id', true);
                if ($product_id) {
                    $product = wc_get_product($product_id);
                    if ($product) {
                        echo esc_html($product->get_name()) . ' (#' . $product_id . ')';
                    }
                } else {
                    echo '<em>' . __('Not set', 'woo-oneclick') . '</em>';
                }
                break;

            case 'offer':
                $product_id = get_post_meta($post_id, '_offer_product_id', true);
                if ($product_id) {
                    $product = wc_get_product($product_id);
                    if ($product) {
                        echo esc_html($product->get_name()) . ' (#' . $product_id . ')';
                    }
                } else {
                    echo '<em>' . __('Not set', 'woo-oneclick') . '</em>';
                }
                break;

            case 'discount':
                $discount = get_post_meta($post_id, '_offer_discount', true);
                echo $discount ? $discount . '%' : '0%';
                break;

            case 'delay':
                $delay = get_post_meta($post_id, '_campaign_delay', true) ?: '5';
                echo $delay . 'm';
                break;
        }
    }
}
